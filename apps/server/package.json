{
  "name": "@discord-music/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch --enable-source-maps dist/main.js",
    "lint": "biome check src tests",
    "register:commands": "node --enable-source-maps dist/register-commands.js",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@discord-music/contracts": "workspace:*",
    "@discordjs/opus": "0.10.0",
    "@discordjs/voice": "0.19.2",
    "@fastify/cors": "11.2.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/websocket": "11.2.0",
    "better-sqlite3": "13.0.3",
    "discord.js": "14.27.0",
    "fastify": "5.12.1",
    "ky": "1.10.0",
    "pino": "9.9.5",
    "prism-media": "1.3.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.10.13",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "ws": "8.21.3"
  }
}
