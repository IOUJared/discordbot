# Discord application credentials. Never commit real values.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_OWNER_ID=

# Optional comma-separated additional Discord user IDs.
AUTHORIZED_USERS=

# Public browser URLs, without trailing slashes.
FRONTEND_URL=https://example.github.io/discordbot
PUBLIC_URL=https://music-api.example.com

# Runtime storage and listener.
DATABASE_PATH=./data/discord-music.sqlite
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Disconnect from voice after this many seconds with no queued music.
VOICE_IDLE_TIMEOUT=300

# Optional yt-dlp cookie file for authenticated YouTube playback.
# Docker deployments should use the owner-only path mounted by docker-compose.yml.
# Never commit this file or paste its contents into logs.
# YOUTUBE_COOKIES_PATH=/run/secrets/discord-music/youtube.cookies.txt

# Optional override for tests or Discord-compatible API proxies.
DISCORD_API_URL=https://discord.com/api/v10
