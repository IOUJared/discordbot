{
  "name": "discord-music",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @discord-music/server build && pnpm --filter @discord-music/server dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "register:commands": "pnpm --filter @discord-music/server build && pnpm --filter @discord-music/server register:commands",
    "start": "pnpm --filter @discord-music/server start",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11"
  }
}
